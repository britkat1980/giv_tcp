# GivTCP's runtime dependencies. requirements.txt is generated from this, with every version and hash pinned,
# in the image's base so the result matches the image. From this folder (Git Bash: prefix with MSYS_NO_PATHCONV=1):
#   docker run --rm -v "$PWD:/src" -w /src python:3.14.5-alpine sh -c "pip install pip-tools && pip-compile --generate-hashes --allow-unsafe --strip-extras --no-emit-index-url -o requirements.txt requirements.in"
